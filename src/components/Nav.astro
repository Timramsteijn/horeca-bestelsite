---
import {
  Calculator,
  Leaf,
  Link as LinkIcon,
  Package,
  Settings2,
  TrendingUp,
  Truck,
  UtensilsCrossed,
} from "lucide-react";

interface Props {
  active:
    | "voorraad"
    | "koppeltabel"
    | "bestellingen"
    | "trends"
    | "arrangementen"
    | "inkoopadvies"
    | "seizoenen"
    | "beheer";
}

const { active } = Astro.props;

// "Koppeltabel" is instelwerk (de Lightspeed↔Sligro-koppeling), geen
// dagelijkse taak — staat daarom apart onderaan, onder "Beheer".
const dagelijks = [
  { key: "voorraad", href: "/", label: "Voorraad", Icon: Package },
  { key: "bestellingen", href: "/bestellingen/", label: "Leveringen", Icon: Truck },
  { key: "trends", href: "/trends/", label: "Trends", Icon: TrendingUp },
  { key: "arrangementen", href: "/arrangementen/", label: "Arrangementen", Icon: UtensilsCrossed },
  { key: "inkoopadvies", href: "/inkoopadvies/", label: "Inkoopadvies", Icon: Calculator },
] as const;

const beheer = [
  { key: "koppeltabel", href: "/koppeltabel/", label: "Koppeltabel", Icon: LinkIcon },
  { key: "seizoenen", href: "/seizoenen/", label: "Seizoenen", Icon: Leaf },
] as const;

// Mobiel: Beheer-onderdelen zijn geen dagelijkse taak en passen qua aantal
// niet meer los in de onderste tabbalk — daar staat daarom één "Beheer"-
// icoon dat naar een overzichtspagina met beide links gaat.
const isBeheerActief = beheer.some((b) => b.key === active);
const mobielItems = [
  ...dagelijks,
  { key: "beheer" as const, href: "/beheer/", label: "Beheer", Icon: Settings2 },
] as const;
---

<!-- Mobiel: navy topbalk met logo + titel -->
<header
  class="flex desktop:hidden h-14 shrink-0 items-center gap-2.5 bg-navy px-[18px] text-creme"
>
  <img src="/logo-ov-mark.svg" alt="" width="28" height="28" class="shrink-0" />
  <span class="kicker text-[12px] text-text-on-dark">Sligro-voorraad · Pannenkoekhut</span>
</header>

<!-- Mobiel: onderste tabbalk, 5 dagelijkse onderdelen + 1 "Beheer" -->
<nav
  aria-label="Onderdelen"
  class="motion fixed inset-x-0 bottom-0 z-10 flex desktop:hidden h-16 items-stretch border-t border-border-light bg-white"
>
  {
    mobielItems.map(({ key, href, label, Icon }) => {
      const isActive = key === "beheer" ? isBeheerActief : key === active;
      return (
        <a
          href={href}
          aria-current={isActive ? "page" : undefined}
          class={`motion flex min-w-0 flex-1 flex-col items-center justify-center gap-0.5 px-0.5 text-center text-[9px] leading-tight font-semibold ${
            isActive ? "text-accent-ink" : "text-text-muted"
          }`}
        >
          <Icon size={20} strokeWidth={2} color="currentColor" className="shrink-0" />
          <span class="w-full truncate">{label}</span>
        </a>
      );
    })
  }
</nav>

<!-- Desktop: navy zijnav, 232px -->
<aside class="hidden desktop:flex w-[232px] shrink-0 flex-col bg-navy px-4 py-5 text-creme">
  <div class="flex items-center gap-2.5 px-2 pb-6">
    <img src="/logo-ov-mark.svg" alt="" width="32" height="32" class="shrink-0" />
    <span class="kicker text-[12px] leading-tight text-text-on-dark">
      Sligro-voorraad<br />Pannenkoekhut
    </span>
  </div>
  <nav aria-label="Onderdelen" class="flex flex-col gap-1">
    {
      dagelijks.map(({ key, href, label, Icon }) => {
        const isActive = key === active;
        return (
          <a
            href={href}
            aria-current={isActive ? "page" : undefined}
            class={`motion flex items-center gap-2.5 rounded-[10px] px-3 py-2.5 text-[14px] font-semibold ${
              isActive
                ? "bg-navy-light text-creme"
                : "text-text-on-dark hover:bg-navy-light hover:text-creme"
            }`}
          >
            <Icon size={20} strokeWidth={2} color="currentColor" />
            {label}
          </a>
        );
      })
    }

    <div class="mt-3 border-t border-border-dark pt-3">
      <p class="kicker px-3 pb-1.5 text-[10px] text-text-on-dark">Beheer</p>
      {
        beheer.map(({ key, href, label, Icon }) => {
          const isActive = key === active;
          return (
            <a
              href={href}
              aria-current={isActive ? "page" : undefined}
              class={`motion flex items-center gap-2.5 rounded-[10px] px-3 py-2.5 text-[14px] font-semibold ${
                isActive
                  ? "bg-navy-light text-creme"
                  : "text-text-on-dark hover:bg-navy-light hover:text-creme"
              }`}
            >
              <Icon size={20} strokeWidth={2} color="currentColor" />
              {label}
            </a>
          );
        })
      }
    </div>
  </nav>
</aside>
